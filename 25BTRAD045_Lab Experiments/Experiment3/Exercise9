students = {}

n = int(input("Enter number of students: "))

for i in range(n):
name = input("\nEnter student name: ")
marks = float(input("Enter marks (0-100): "))

students[name] = marks

print("\n--- STUDENT GRADING SYSTEM ---")

for name, marks in students.items():

if marks >= 90:
grade = "A+"
elif marks >= 80:
grade = "A"
elif marks >= 70:
grade = "B"
elif marks >= 60:
grade = "C"
elif marks >= 50:
grade = "D"
elif marks >= 35:
grade = "E"
else:
grade = "Fail"

print("\nStudent Name:", name)
print("Marks:", marks)
print("Grade:", grade)
